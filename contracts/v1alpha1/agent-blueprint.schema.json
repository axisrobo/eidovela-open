{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidovela.axisrobo.io/contracts/v1alpha1/agent-blueprint.json",
  "title": "AgentBlueprint",
  "type": "object",
  "required": [
    "blueprint_id",
    "tenant_id",
    "publisher",
    "version",
    "declared_class",
    "status"
  ],
  "properties": {
    "blueprint_id": { "type": "string" },
    "tenant_id": { "type": "string" },
    "publisher": { "type": "string" },
    "version": { "type": "string" },
    "declared_class": { "type": "string", "enum": ["twin", "service", "ephemeral"] },
    "metadata": { "type": "object" },
    "allowed_enrollment_profiles": {
      "type": "array",
      "items": { "type": "string", "enum": ["private_key_jwt", "mtls", "spiffe_svid", "k8s_projected_sa", "device_attestation"] },
      "uniqueItems": true
    },
    "status": { "type": "string", "enum": ["draft", "published", "deprecated"] }
  },
  "additionalProperties": false
}
