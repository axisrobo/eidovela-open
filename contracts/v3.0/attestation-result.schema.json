{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/axisrobo/eidovela-open/contracts/v3.0/attestation-result.schema.json",
  "title": "AttestationResult",
  "description": "Sanitized EIDOVELA record of the evidence that bound a workload to an Agent Instance. Raw certificates, projected tokens, private keys and unrestricted attributes are never present.",
  "type": "object",
  "required": [
    "attestationRef",
    "agentId",
    "enrollmentId",
    "method",
    "verifierIdentity",
    "evidenceDigest",
    "attributesDigest",
    "createdAt"
  ],
  "properties": {
    "attestationRef": { "type": "string", "minLength": 1 },
    
    "agentId": { "type": "string", "minLength": 1 },
    "enrollmentId": { "type": "string", "minLength": 1 },
    "method": {
      "enum": ["private_key_jwt", "spiffe_svid", "k8s_projected_sa", "mtls"]
    },
    "verifierIdentity": { "type": "string", "minLength": 1 },
    "evidenceDigest": { "type": "string", "pattern": "^sha256:" },
    "attributesDigest": { "type": "string", "pattern": "^sha256:" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
