{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/axisrobo/eidovela-open/contracts/v3.0/credential.schema.json",
  "title": "IdentityCredential",
  "description": "EIDOVELA identity credential binding a public key thumbprint to an Agent Identity. Never contains private key material.",
  "type": "object",
  "required": ["kid", "agentId", "keyThumbprint", "status"],
  "properties": {
    "kid": { "type": "string", "minLength": 1 },
    "agentId": { "type": "string", "minLength": 1 },
    
    "keyThumbprint": { "type": "string", "minLength": 1 },
    "status": { "enum": ["active", "revoked"] },
    "credentialGeneration": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": true
}
