{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/axisrobo/eidovela-open/contracts/v2/credential.schema.json",
  "title": "IdentityCredential",
  "description": "EIDOVELA identity credential binding a public key thumbprint to an Agent Identity. Never contains private key material.",
  "type": "object",
  "required": ["kid", "agent_id", "tenant_id", "key_thumbprint", "status"],
  "properties": {
    "kid": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "key_thumbprint": { "type": "string", "minLength": 1 },
    "status": { "enum": ["active", "revoked"] },
    "credential_generation": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": true
}
