#!/usr/bin/env bash
# Local CI for eidovela-open (Apache-2.0). Mirrors .github/workflows/ci.yml:
#   - gofmt / go build / go vet
#   - Go SDK unit tests
#   - full conformance runner against a locally built core daemon
#
# The conformance daemon is built from the sibling core checkout
# (../eidovela/backend) when a platform binary is missing under conformance/bin,
# so the fixtures always exercise current core behavior.
set -euo pipefail

cd "$(dirname "$0")/.."

case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) DAEMON=conformance/bin/eidovelad.exe ;;
  *) DAEMON=conformance/bin/eidovelad ;;
esac

echo "== gofmt =="
bad=""
gofmt_check() {
  for dir in "$@"; do
    while IFS= read -r f; do
      # Normalize CRLF (Windows checkouts) before comparing so the gate matches
      # a clean Linux CI clone.
      if ! sed 's/\r$//' "$f" | gofmt -d >/dev/null 2>&1; then
        bad="$bad $f"
      fi
    done < <(find "$dir" -name '*.go' -type f)
  done
}
gofmt_check ./cmd ./sdk ./conformance/runner ./examples
if [ -n "$bad" ]; then
  echo "gofmt needed:"; echo "$bad"; exit 1
fi

echo "== go build =="
go build ./...
echo "== go vet =="
go vet ./conformance/... ./cmd/... ./sdk/...
echo "== go test (SDK) =="
go test ./sdk/... -count=1

if [ ! -f "$DAEMON" ] && [ -d "../eidovela/backend" ]; then
  echo "== build core daemon =="
  ( cd "../eidovela/backend" && go build -o "../../eidovela-open/$DAEMON" ./cmd/eidovelad )
fi
if [ -f "$DAEMON" ]; then
  echo "== conformance =="
  go test ./conformance/runner/ -run TestFixturesAgainstDaemon -count=1
else
  echo "!! no $DAEMON and no sibling core checkout; skipping conformance"
fi

echo "== local CI OK =="
