{
  "id": "P-I1-1",
  "description": "A leased instance issues an active token until the lease lapses",
  "threat_ref": "I1",
  "expectation": "allow",
  "scenario": {
    "agent_class": "twin",
    "binding_type": "human_master",
    "authority_root_ref": "user:alice@example.test",
    "steps": [
      {
        "op": "register_workload",
        "workload": {
          "platform": "kubernetes",
          "selector": { "namespace": "prod", "serviceaccount": "agent" },
          "trust_domain": "example.test",
          "allowed_proof_methods": ["private_key_jwt"]
        }
      },
      { "op": "complete_enrollment", "attestation": { "method": "private_key_jwt" }, "workload_attributes": { "namespace": "prod", "serviceaccount": "agent" } },
      { "op": "activate" },
      { "op": "instance_lease", "expect": "ok" },
      { "op": "issue_token", "audience": "aegivela", "present_key": "main", "expect": "ok" },
      { "op": "introspect", "audience": "aegivela", "present_key": "main", "expect": "ok" }
    ]
  }
}
