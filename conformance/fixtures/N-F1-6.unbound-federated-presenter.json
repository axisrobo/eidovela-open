{
  "id": "N-F1-6",
  "description": "A peer token presented by a caller who does not possess its PoP key is inactive",
  "threat_ref": "F1",
  "expectation": "deny",
  "deny_reason": "PoP key mismatch",
  "scenario": {
    "agent_class": "service",
    "binding_type": "organization_root",
    "authority_root_ref": "org:peer-console",
    "steps": [
      {
        "op": "register_federation_trust",
        "federation": {
          "issuer": "https://peer.example.test",
          "allowed_audiences": ["aegivela"],
          "claim_mappings": { "agent_id": "sub" },
          "status": "active"
        }
      },
      { "op": "issue_peer_token", "audience": "aegivela", "federation_issuer": "https://peer.example.test" },
      { "op": "introspect", "audience": "aegivela", "present_key": "attacker", "expect": "deny" }
    ]
  }
}
