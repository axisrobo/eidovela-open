{
  "id": "P-T2-1",
  "description": "A matching SPIFFE SVID satisfies workload enrollment and yields an active token",
  "threat_ref": "T2",
  "expectation": "allow",
  "scenario": {
    "agent_class": "twin",
    "binding_type": "human_master",
    "authority_root_ref": "user:alice@example.test",
    "steps": [
      {
        "op": "register_workload",
        "workload": {
          "platform": "spiffe",
          "selector": { "spiffe_path": "/ns/payments/sa/agent" },
          "trust_domain": "prod.example.test",
          "allowed_proof_methods": ["private_key_jwt", "spiffe_svid"]
        }
      },
      {
        "op": "complete_enrollment",
        "attestation": { "method": "spiffe_svid", "spiffe_id": "spiffe://prod.example.test/ns/payments/sa/agent" }
      },
      { "op": "activate" },
      { "op": "issue_token", "audience": "aegivela", "present_key": "main" },
      { "op": "introspect", "audience": "aegivela", "present_key": "main", "expect": "ok" }
    ]
  }
}
