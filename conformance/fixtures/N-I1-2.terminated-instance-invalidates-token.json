{
  "id": "N-I1-2",
  "description": "A token issued before registry instance termination is inactive on the next online verification",
  "threat_ref": "I1",
  "expectation": "deny",
  "deny_reason": "registry instance terminated",
  "scenario": {
    "agent_class": "service",
    "binding_type": "organization_root",
    "authority_root_ref": "org:instance-invalidation",
    "steps": [
      {
        "op": "register_workload",
        "workload": {
          "platform": "kubernetes",
          "selector": { "namespace": "prod", "serviceaccount": "agent" },
          "trust_domain": "example.test",
          "allowed_proof_methods": ["private_key_jwt"]
        }
      },
      { "op": "complete_enrollment", "attestation": { "method": "private_key_jwt" }, "workload_attributes": { "namespace": "prod", "serviceaccount": "agent" } },
      { "op": "activate" },
      { "op": "issue_token", "audience": "aegivela", "present_key": "main" },
      { "op": "instance_terminate" },
      { "op": "introspect", "audience": "aegivela", "present_key": "main", "expect": "deny", "deny_reason": "inactive" }
    ]
  }
}
