{
  "id": "N-T2-5",
  "description": "A verified Kubernetes projected token for another namespace or ServiceAccount cannot enroll the Agent",
  "threat_ref": "T2",
  "expectation": "deny",
  "deny_reason": "Kubernetes ServiceAccount selector mismatch",
  "input": {
    "operation": "enroll",
    "proof": { "method": "k8s_projected_sa", "issuer": "https://kubernetes.example.test", "audience": "eidovela", "subject": "system:serviceaccount:other:agent" },
    "registry_state": { "selector": { "namespace": "payments", "serviceaccount": "agent" } }
  }
}
